environments:
  default:
    values:
      - ./helmfile-values.yaml

---

{{- if and .Values.smartHome.zigbee2mqtt.enabled (not .Values.smartHome.mqtt.enabled) }}
{{- fail "smartHome.mqtt.enabled must be true before enabling Zigbee2MQTT" }}
{{- end }}

repositories:
  - name: cert-manager
    url: https://charts.jetstack.io
  - name: hashicorp
    url: https://helm.releases.hashicorp.com
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: metrics-server
    url: https://kubernetes-sigs.github.io/metrics-server/
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: tailscale
    url: https://pkgs.tailscale.com/helmcharts
  - name: traefik
    url: https://traefik.github.io/charts

releases:
###  CORE  ###
  - name: namespaces
    chart: ./core/namespaces
    historyMax: 5
    namespace: kube-system
    labels: {stage: foundation, domain: platform, criticality: core}
  - name: rbac-policies
    chart: ./core/rbac-policies
    historyMax: 5
    namespace: kube-system
    needs: [kube-system/namespaces]
    labels: {stage: foundation, domain: platform, criticality: core}
  - name: butler-crds
    chart: ./core/butler-crds
    historyMax: 5
    namespace: kube-system
    needs: [kube-system/namespaces]
    labels: {stage: foundation, domain: control-plane, criticality: core}
  - name: metrics-server
    chart: ./core/metrics-server
    historyMax: 5
    namespace: kube-system
    needs: [kube-system/namespaces, kube-system/rbac-policies]
    labels: {stage: foundation, domain: platform, criticality: core}
  - name: cert-manager
    chart: ./core/cert-manager
    historyMax: 5
    namespace: cert-manager
    needs: [kube-system/namespaces]
    labels: {stage: networking, domain: platform, criticality: core}

###  NETWORKING  ###
  - name: public-certificates
    chart: ./networking/certificates
    historyMax: 5
    namespace: networking
    # Keep custom resources out of cert-manager's first install transaction.
    # Helm can discover these kinds only after that release installs its CRDs.
    # The issuer then waits for VSO to project Butler's acme-dns registration.
    needs: [cert-manager/cert-manager]
    labels: {stage: networking, domain: platform, criticality: core}
  - name: traefik
    chart: ./networking/traefik
    historyMax: 5
    namespace: networking
    needs: [kube-system/namespaces, kube-system/rbac-policies]
    labels: {stage: networking, domain: platform, criticality: core}

###  SECURITY  ###
  - name: vault
    chart: ./security/vault
    historyMax: 5
    namespace: security
    needs: [kube-system/namespaces, kube-system/rbac-policies]
    labels: {stage: secrets, domain: platform, criticality: essential}
  - name: butler
    chart: ./services/butler
    historyMax: 5
    namespace: security
    needs: [kube-system/namespaces, kube-system/rbac-policies, kube-system/butler-crds, cert-manager/cert-manager, networking/traefik, security/vault]
    labels: {stage: secrets, domain: control-plane, criticality: essential}
    values:
      - ./services/butler/helmfile-values.yaml.gotmpl
  - name: vault-secrets-operator
    chart: ./security/vault-secrets-operator
    historyMax: 5
    namespace: security
    needs: [kube-system/namespaces, security/butler]
    labels: {stage: secrets, domain: platform, criticality: essential}
  - name: pocket-id
    chart: ./security/pocket-id
    historyMax: 5
    namespace: security
    # pocket-id needs cert-manager (TLS cert), traefik (ingress), and VSO
    # (Vault-managed encryption-key Secret).
    needs:
      - kube-system/namespaces
      - cert-manager/cert-manager
      - networking/traefik
      - security/vault-secrets-operator
    labels: {stage: identity, domain: identity, criticality: essential}
    values:
      - ./security/pocket-id/helmfile-values.yaml.gotmpl
###  DATABASES  ###
  - name: postgresql
    chart: ./databases/postgresql
    historyMax: 5
    namespace: databases
    needs: [kube-system/namespaces, kube-system/rbac-policies, security/vault-secrets-operator]
    labels: {stage: data, domain: data, criticality: essential}
  - name: redis
    chart: ./databases/redis
    historyMax: 5
    namespace: databases
    needs: [kube-system/namespaces, kube-system/rbac-policies, security/vault-secrets-operator]
    labels: {stage: data, domain: data, criticality: shared}

###  STORAGE  ###
  - name: garage
    chart: ./storage/garage
    historyMax: 5
    namespace: storage
    needs: [kube-system/namespaces, kube-system/rbac-policies, security/vault-secrets-operator]
    labels: {stage: data, domain: data, criticality: shared}

###  MONITORING  ###
  - name: prometheus
    chart: ./monitoring/prometheus
    historyMax: 5
    namespace: monitoring
    needs: [kube-system/namespaces, kube-system/rbac-policies]
    labels: {stage: observability, domain: observability, criticality: important}
  - name: loki
    chart: ./monitoring/loki
    historyMax: 5
    namespace: monitoring
    needs: [kube-system/namespaces]
    labels: {stage: observability, domain: observability, criticality: important}
  - name: tempo
    chart: ./monitoring/tempo
    historyMax: 5
    namespace: monitoring
    needs: [kube-system/namespaces]
    labels: {stage: observability, domain: observability, criticality: standard}
  - name: alloy
    chart: ./monitoring/alloy
    historyMax: 5
    namespace: monitoring
    needs: [monitoring/prometheus, monitoring/loki, monitoring/tempo]
    labels: {stage: observability, domain: observability, criticality: important}
  - name: grafana
    chart: ./monitoring/grafana
    historyMax: 5
    namespace: monitoring
    needs: [monitoring/prometheus, monitoring/loki, monitoring/tempo, security/pocket-id, security/vault-secrets-operator]
    labels: {stage: observability, domain: observability, criticality: important}
  - name: monitoring-policies
    chart: ./monitoring/policies
    historyMax: 5
    namespace: monitoring
    needs: [monitoring/alloy, monitoring/grafana]
    labels: {stage: observability, domain: observability, criticality: core}

###  SMART HOME  ###
  - name: home-assistant
    chart: ./smart-home/home-assistant
    installed: {{ .Values.smartHome.homeAssistant.enabled }}
    historyMax: 5
    namespace: smart-home
    needs: [kube-system/namespaces]
    labels: {stage: smart-home, domain: home-automation, component: home-assistant, criticality: important}
  - name: mosquitto
    chart: ./smart-home/mosquitto
    installed: {{ .Values.smartHome.mqtt.enabled }}
    historyMax: 5
    namespace: smart-home
    needs: [kube-system/namespaces, security/vault-secrets-operator]
    labels: {stage: smart-home, domain: home-automation, component: mqtt, criticality: important}
  - name: zigbee2mqtt
    chart: ./smart-home/zigbee2mqtt
    installed: {{ .Values.smartHome.zigbee2mqtt.enabled }}
    historyMax: 5
    namespace: zigbee
    needs: [kube-system/namespaces, security/vault-secrets-operator, smart-home/mosquitto]
    labels: {stage: smart-home, domain: home-automation, component: zigbee, criticality: important}
    values:
      - coordinator:
          device: {{ .Values.smartHome.zigbee2mqtt.device | quote }}
          adapter: {{ .Values.smartHome.zigbee2mqtt.adapter | quote }}

###  APPLICATIONS  ###
  - name: homepage
    chart: ./applications/homepage
    historyMax: 5
    namespace: homepage
    needs: [kube-system/namespaces, security/pocket-id, security/vault-secrets-operator]
    labels: {stage: applications, domain: applications, criticality: standard}
  - name: paperless-ngx
    chart: ./applications/paperless-ngx
    historyMax: 5
    namespace: paperless-ngx
    needs: [kube-system/namespaces, databases/postgresql, databases/redis, security/vault-secrets-operator]
    labels: {stage: applications, domain: applications, criticality: important}
  - name: kitchenowl
    chart: ./applications/kitchenowl
    historyMax: 5
    namespace: kitchenowl
    needs: [kube-system/namespaces, security/vault-secrets-operator]
    labels: {stage: applications, domain: applications, criticality: standard}
  - name: ntfy
    chart: ./applications/ntfy
    historyMax: 5
    namespace: ntfy
    needs: [kube-system/namespaces]
    labels: {stage: applications, domain: applications, criticality: standard}
  - name: vaultwarden
    chart: ./applications/vaultwarden
    historyMax: 5
    namespace: vaultwarden
    needs: [kube-system/namespaces, databases/postgresql, security/vault-secrets-operator]
    labels: {stage: applications, domain: applications, criticality: important}

###  NETWORKING  ###
  # - name: tailscale
  #   chart: ./networking/tailscale
  #   historyMax: 5
  #   namespace: networking
  #   needs: [kube-system/namespaces]

###  CI/CD  ###
  - name: actions-runner-controller
    chart: ./cicd/actions-runner-controller
    historyMax: 5
    namespace: cicd
    needs: [kube-system/namespaces]
    labels: {stage: cicd, domain: delivery, criticality: standard}
  - name: homelab-runners
    chart: ./cicd/actions-runner-scale-set
    historyMax: 5
    namespace: cicd
    needs: [kube-system/namespaces, security/vault-secrets-operator, cicd/actions-runner-controller]
    labels: {stage: cicd, domain: delivery, criticality: standard}
